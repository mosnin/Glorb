# ───────────────────────────────────────────────────
# Clerk (Authentication)
# https://dashboard.clerk.com → Create application
# ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=    # pk_test_... (from Clerk dashboard → API Keys)
CLERK_SECRET_KEY=                     # sk_test_... (from Clerk dashboard → API Keys)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=                 # whsec_... (from Clerk dashboard → Webhooks)

# ───────────────────────────────────────────────────
# Supabase (Database & Storage)
# https://supabase.com → New Project
# ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=             # https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # eyJ... (from Settings → API → anon public)
SUPABASE_SERVICE_ROLE_KEY=            # eyJ... (from Settings → API → service_role secret)

# ───────────────────────────────────────────────────
# OpenAI (Chat builder agent)
# https://platform.openai.com/api-keys
# ───────────────────────────────────────────────────
OPENAI_API_KEY=                       # sk-... (used for the chat builder)

# ───────────────────────────────────────────────────
# Anthropic (Agent & Cluster runtime)
# https://console.anthropic.com/settings/keys
# ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # sk-ant-... (used for running agents)

# ───────────────────────────────────────────────────
# GitHub OAuth (Repository sync)
# https://github.com/settings/developers → New OAuth App
# ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=                     # Ov23li... (from GitHub OAuth App)
GITHUB_CLIENT_SECRET=                 # github client secret

# ───────────────────────────────────────────────────
# Resend (Email notifications) — OPTIONAL
# https://resend.com/api-keys
# ───────────────────────────────────────────────────
RESEND_API_KEY=                       # re_... (from Resend dashboard)
RESEND_FROM_EMAIL=Glorb <alerts@glorb.dev>  # Verified sender address

# ───────────────────────────────────────────────────
# App Configuration — OPTIONAL
# ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Public URL (used in emails)
CRON_SECRET=                                # Shared secret for /api/cron (set on Railway + cron service)
